# AE Sentinel 环境变量配置模板
# 复制此文件为 .env 并填入实际值（.env 不提交到 git）

# 数据库引擎: mysql 或 sqlite（开发环境使用 sqlite）
DATABASE_ENGINE=sqlite

# MySQL 配置（DATABASE_ENGINE=mysql 时需要）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ae_sentinel

# JWT 密钥（生产环境必须修改为随机字符串）
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_EXPIRE_SECONDS=3600

# LLM API Keys（可选）
ZHIPU_API_KEY=
QWEN_API_KEY=
LLM_MODEL=glm-4
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 外部 API Keys（可选）
NCBI_API_KEY=
FAERS_API_KEY=
